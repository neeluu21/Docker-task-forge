# Docker Hub username used by compose for pre-built images.
DOCKERHUB_USERNAME=neelu196

# Docker image tag. Use v1.0.0 for the first release.
TASKFORGE_TAG=v1.0.0

# Application host port.
APP_PORT=8080

# MongoDB runtime configuration.
MONGO_DATABASE=taskforge
MONGO_USERNAME=taskforge_admin
MONGO_PASSWORD=change_me_before_production
